# Saklar backend. true (default) = backend DIPUTUS: semua halaman terbuka tanpa
# login, data dummy, role bisa dipindah Customer <-> Admin lewat menu akun.
# Ubah ke false untuk memakai backend NestJS asli.
VITE_USE_MOCK_BACKEND=true

# URL backend NestJS (Cateringin) — hanya dipakai kalau VITE_USE_MOCK_BACKEND=false.
VITE_API_BASE_URL=http://localhost:3000
